.DS_Store

# Claude Code creates isolated parallel sessions here.
.claude/worktrees/

# New Claude Design downloads are transient until imported as a numbered round.
docs/design/claude-design/inbox/*.zip

*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Supabase CLI local cache (contains project ref + pooler URL; never commit).
supabase/.temp/

# ZCode agent session state (transient, agent-specific).
.zcode/

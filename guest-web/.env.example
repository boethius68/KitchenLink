# Gast-Web Sandbox-Umgebung (KEINE Secrets hier; nur NEXT_PUBLIC_*-Platzhalter).
#
# Diese Datei enthält keine echten Werte. Trage in deiner lokalen Kopie
# (.env.local, nicht committet) die Werte deines Sandbox-Supabase-Projekts
# ein. Ohne konfigurierte Supabase-Instanz schlagen Anonymous-Sign-in und
# Bestell-RPC zur Laufzeit fehl — siehe docs/architecture/guest-web/ORDER_GATE.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

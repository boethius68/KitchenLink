{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitchenlink.local/discovery/menu_schema_v0.1.json",
  "title": "KitchenLink Menu Import Draft v0.1",
  "description": "Lossless, evidence-bound menu import contract. Discovery artifact, NOT a production schema. Every normalized value MUST carry raw text, source location, confidence and review status. 'unknown' is always valid. No allergens/additives/ingredients/claims may be derived from world knowledge.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceEvidence",
    "draft"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2.0",
      "description": "Pinned schema/ontology/prompt/model version captured per draft. v0.2.0: per_unit removed from priceKind enum (now Offer.grundpreis); if/then price constraints added; BundleComponent.optionGroup required."
    },
    "sourceEvidence": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "draft": {
      "$ref": "#/$defs/MenuImportDraft"
    }
  },
  "$defs": {
    "SourceEvidence": {
      "type": "object",
      "description": "Provenance of the source document (image/PDF/HTML). Rights/access status must be recorded; private user uploads are forbidden in research.",
      "required": [
        "sourceId",
        "canonicalUrl",
        "accessedAt",
        "rightsStatus",
        "contentFingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        },
        "provider": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "description": "ISO-3166-1 alpha-2"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "BCP-47, e.g. de-DE"
          }
        },
        "venueType": {
          "type": "string",
          "description": "Free descriptor kept as-is; canonical facet lives on the draft.",
          "examples": [
            "restaurant",
            "cafe",
            "bar",
            "biergarten",
            "fine_dining",
            "hotel",
            "delivery",
            "bakery",
            "canteen",
            "seasonal"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "photo",
            "scan",
            "text_pdf",
            "image_pdf",
            "html",
            "qr_menu",
            "unknown"
          ]
        },
        "officialSource": {
          "type": "boolean"
        },
        "accessedAt": {
          "type": "string",
          "format": "date"
        },
        "rightsStatus": {
          "type": "string",
          "enum": [
            "reusable",
            "research_only",
            "metadata_only",
            "unclear",
            "excluded"
          ]
        },
        "robotsStatus": {
          "type": "string",
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ]
        },
        "contentFingerprint": {
          "type": "string",
          "description": "sha256 of normalized text or perceptual hash for images"
        },
        "duplicateCluster": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "description": "Traceability back to the original. Required for any normalized value.",
      "required": [
        "rawText",
        "sourceId",
        "confidence",
        "reviewStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "rawText": {
          "type": "string",
          "description": "Verbatim original text, original spelling."
        },
        "sourceId": {
          "type": "string"
        },
        "directUrl": {
          "type": "string",
          "format": "uri"
        },
        "pageOrLocation": {
          "type": "string",
          "description": "Page index, section title, bounding box, OCR span — whatever locates the evidence."
        },
        "method": {
          "type": "string",
          "enum": [
            "ocr",
            "ocr_on_enhanced",
            "layout_rule",
            "llm",
            "human",
            "imported",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "unreviewed",
            "human_accepted",
            "human_edited",
            "human_rejected",
            "unknown"
          ]
        }
      }
    },
    "LocalizableText": {
      "type": "object",
      "description": "Original text plus optional translations. Translations MUST be marked as translations, never overwrite the original.",
      "required": [
        "value",
        "lang"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "description": "BCP-47"
        },
        "isTranslation": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "MenuImportDraft": {
      "type": "object",
      "required": [
        "menuTitle",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "menuTitle": {
          "$ref": "#/$defs/LocalizableText"
        },
        "menuTitleEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "declaredLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "globalLegends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Legend"
          },
          "description": "Legends stated to apply to the whole menu. Scope-existence must be explicit; never assume."
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        }
      }
    },
    "Section": {
      "type": "object",
      "description": "Visible, ordered, nestable menu section. Original title/spelling/order preserved.",
      "required": [
        "originalTitle",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "sectionId": {
          "type": "string"
        },
        "originalTitle": {
          "$ref": "#/$defs/LocalizableText"
        },
        "titleEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "subSections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "facets": {
          "$ref": "#/$defs/SectionFacets"
        },
        "localLegends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Legend"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          }
        },
        "continuedFromSectionId": {
          "type": [
            "string",
            "null"
          ],
          "description": "If a section visibly continues from a previous page/section, link it; else null."
        }
      }
    },
    "SectionFacets": {
      "type": "object",
      "description": "Independent classification axes. NEVER a single flat list. Each facet allows unknown/unmapped plus documented extension.",
      "additionalProperties": false,
      "properties": {
        "consumptionFamily": {
          "type": "string",
          "enum": [
            "food",
            "drink",
            "bundle",
            "retail",
            "fee_deposit",
            "information",
            "unknown"
          ],
          "description": "What kind of sellable thing this is."
        },
        "courseRole": {
          "type": "string",
          "description": "Free, extensible role string (NOT closed enum): breakfast, appetizer, soup, salad, main, side, dessert, snack, kids, sharing, daily, tasting, set_menu, unknown ...",
          "examples": [
            "appetizer",
            "main",
            "dessert",
            "kids",
            "tasting",
            "daily",
            "unknown"
          ]
        },
        "productFamily": {
          "type": "string",
          "description": "Extensible tree path, e.g. 'drink/wine/white/riesling'. Never closed. Use 'unknown' rather than forcing a guess."
        },
        "context": {
          "$ref": "#/$defs/ContextFacet"
        }
      }
    },
    "ContextFacet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeOfDay": {
          "type": "string",
          "description": "free/extensible: breakfast, lunch, dinner, all_day, unknown"
        },
        "dayOfWeek": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "season": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "dine_in",
            "takeaway",
            "delivery",
            "catering",
            "all",
            "unknown"
          ]
        },
        "location": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "description": "free: kids, sharing, min_persons:4, unknown"
        },
        "minPersons": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "Entry": {
      "type": "object",
      "description": "A single sellable line. Entry kind drives what fields are meaningful.",
      "required": [
        "entryKind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "entryId": {
          "type": "string"
        },
        "entryKind": {
          "type": "string",
          "enum": [
            "simple_item",
            "configurable_item",
            "bundle",
            "notice",
            "fee_deposit",
            "unknown"
          ]
        },
        "name": {
          "$ref": "#/$defs/LocalizableText"
        },
        "nameEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "description": {
          "$ref": "#/$defs/LocalizableText"
        },
        "descriptionEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "itemNumber": {
          "type": "string",
          "description": "Verbatim numbering if present."
        },
        "repeatedPlacement": {
          "type": "boolean",
          "default": false,
          "description": "True if the same item appears in multiple sections (must not be silently deduped)."
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "limited",
                "unknown"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/EvidenceRef"
            }
          }
        },
        "facets": {
          "$ref": "#/$defs/SectionFacets"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Offer"
          }
        },
        "quantities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quantity"
          }
        },
        "optionGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionGroup"
          }
        },
        "bundleComponents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BundleComponent"
          },
          "description": "Only for entryKind=bundle. Each component may itself be configurable."
        },
        "declarations": {
          "$ref": "#/$defs/Declarations"
        }
      }
    },
    "Quantity": {
      "type": "object",
      "description": "Quantity axis. Unit is free/extensible; canonical categories are ml/cl/l, mg/g/kg, piece, portion, person, diameter, plus free text.",
      "required": [
        "rawQuantity"
      ],
      "additionalProperties": false,
      "properties": {
        "rawQuantity": {
          "type": "string",
          "description": "Verbatim, e.g. '0,5 l', '1/2 Pfund', 'Ø 32 cm', '2 Personen'."
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "examples": [
            "ml",
            "cl",
            "l",
            "mg",
            "g",
            "kg",
            "piece",
            "portion",
            "person",
            "diameter_cm",
            "unknown"
          ]
        },
        "unitCategory": {
          "type": "string",
          "enum": [
            "volume",
            "weight",
            "count",
            "portion",
            "person",
            "diameter",
            "free",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceRef"
        }
      }
    },
    "Offer": {
      "type": "object",
      "description": "A price statement. Absolute price and price delta are STRICTLY separated. An item with no visible base price (price only at a variant) is modeled as priceKind=unknown on the item.",
      "required": [
        "priceKind",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "priceKind": {
                "const": "delta"
              }
            }
          },
          "then": {
            "properties": {
              "amountCents": {
                "const": null
              },
              "deltaCents": {
                "type": "integer"
              }
            },
            "required": [
              "deltaCents"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "priceKind": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "deltaCents": {
                "const": null
              },
              "amountCents": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "amountCents"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "priceKind": {
                "const": "included"
              }
            }
          },
          "then": {
            "properties": {
              "amountCents": {
                "const": null
              },
              "deltaCents": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "priceKind": {
                "const": "free"
              }
            }
          },
          "then": {
            "properties": {
              "amountCents": {
                "const": 0
              },
              "deltaCents": {
                "const": null
              }
            }
          }
        }
      ],
      "properties": {
        "priceKind": {
          "type": "string",
          "enum": [
            "fixed",
            "from",
            "range",
            "market",
            "on_request",
            "included",
            "free",
            "delta",
            "unknown"
          ]
        },
        "amountCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Absolute amount in minor units. Null unless a concrete absolute price is visible."
        },
        "deltaCents": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Signed surcharge/discount relative to a base; only for priceKind=delta."
        },
        "minAmountCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxAmountCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "description": "ISO-4217, e.g. EUR"
        },
        "rawPrice": {
          "type": "string",
          "description": "Verbatim price token, e.g. 'ab 9,00 €', 'auf Anfrage', 'Marktpreis'."
        },
        "basis": {
          "type": "string",
          "enum": [
            "per_item",
            "per_person",
            "per_piece",
            "per_weight",
            "per_volume",
            "per_unit",
            "unknown"
          ]
        },
        "appliesToQuantity": {
          "type": "string",
          "description": "Reference to a Quantity.rawQuantity this price attaches to, e.g. '0,5 l'."
        },
        "deposit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amountCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "depositType": {
              "type": "string",
              "enum": [
                "single_use",
                "reusable",
                "unknown"
              ]
            },
            "rawText": {
              "type": "string"
            }
          }
        },
        "grundpreis": {
          "type": "object",
          "description": "Per-unit base price required by PAngV (e.g. '1 L = 11,80 €'). Separate from the main price; not a priceKind value.",
          "additionalProperties": false,
          "properties": {
            "amountCents": {
              "type": "integer",
              "minimum": 0
            },
            "basis": {
              "type": "string",
              "enum": [
                "per_volume",
                "per_weight",
                "per_piece",
                "per_unit",
                "unknown"
              ]
            },
            "rawText": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/EvidenceRef"
            }
          }
        },
        "packagingFee": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "surcharge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amountCents": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "examples": [
                "credit_card",
                "delivery",
                "evening",
                "unknown"
              ]
            },
            "rawText": {
              "type": "string"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceRef"
        }
      }
    },
    "OptionGroup": {
      "type": "object",
      "description": "A group of choices with selection rules. Modeled after Toast ModifierGroup evidence: required/optional, single/multiple, min/max, defaults, free-selection count, repeat, dependencies.",
      "required": [
        "originalTitle",
        "selectionRule"
      ],
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string"
        },
        "originalTitle": {
          "$ref": "#/$defs/LocalizableText",
          "description": "e.g. 'Größe wählen', 'Beilagenauswahl (1 inklusive)'."
        },
        "titleEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "selectionRule": {
          "type": "object",
          "required": [
            "required",
            "cardinality"
          ],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "string",
              "enum": [
                "required",
                "optional",
                "optional_force_show",
                "unknown"
              ]
            },
            "cardinality": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "unknown"
              ]
            },
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "freeSelectionCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "How many choices are included before a surcharge applies."
            },
            "defaultOptionIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repeatable": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "requires",
                  "excludes",
                  "enables",
                  "unknown"
                ]
              },
              "optionId": {
                "type": "string"
              }
            }
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        }
      }
    },
    "Choice": {
      "type": "object",
      "description": "A modifier/variant inside a group. PRICE SEMANTICS MUST BE EXPLICIT via offer.priceKind: absolute variant price (fixed) vs delta (surcharge) vs included vs unknown.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/LocalizableText"
        },
        "nameEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "choiceKind": {
          "type": "string",
          "enum": [
            "size",
            "portion",
            "volume",
            "preparation",
            "protein",
            "ingredient",
            "side",
            "sauce",
            "dressing",
            "flavor",
            "temperature",
            "addon",
            "remove",
            "substitute",
            "upgrade",
            "bundle_component",
            "unknown"
          ]
        },
        "preModifier": {
          "type": "string",
          "enum": [
            "add",
            "no",
            "sub",
            "extra",
            "on_side",
            "unknown"
          ],
          "description": "Verbatim pre-modifier category as documented by Toast (EXTRA/NO/SUB/ADD/ON SIDE)."
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "offer": {
          "$ref": "#/$defs/Offer"
        },
        "declarations": {
          "$ref": "#/$defs/Declarations"
        }
      }
    },
    "BundleComponent": {
      "type": "object",
      "description": "A slot in a set menu / bundle, e.g. 'Choose one appetizer', 'Meat or shrimp'. Component may itself reference optionGroups.",
      "required": [
        "slotTitle",
        "optionGroup"
      ],
      "additionalProperties": false,
      "properties": {
        "slotTitle": {
          "$ref": "#/$defs/LocalizableText"
        },
        "slotEvidence": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "optionGroup": {
          "$ref": "#/$defs/OptionGroup"
        }
      }
    },
    "Declarations": {
      "type": "object",
      "description": "Only explicitly evidenced statements. NEVER derive allergens/additives/ingredients/claims from world knowledge. Local codes and legend text kept separate from canonical IDs.",
      "additionalProperties": false,
      "properties": {
        "allergens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Declaration"
          }
        },
        "additives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Declaration"
          }
        },
        "ingredients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Declaration"
          },
          "description": "Only if explicitly listed on the menu."
        },
        "dietaryClaims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Declaration"
          },
          "description": "e.g. vegan, vegetarian, gluten_free — only if claimed."
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Declaration"
          }
        }
      }
    },
    "Declaration": {
      "type": "object",
      "required": [
        "rawText",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rawText": {
          "type": "string",
          "description": "Verbatim code/symbol/text, e.g. '1', 'Gf', '🥜', '(enthältSellerie)'."
        },
        "localCode": {
          "type": "string",
          "description": "Local legend key, kept as-is, not auto-mapped."
        },
        "canonicalId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical ID ONLY when a legend explicitly maps the local code. Null otherwise. EU-14 and US Big-8 conflict, so the source legend is authoritative."
        },
